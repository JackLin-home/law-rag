# 阿里云百炼 / DashScope API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Neo4j 图数据库（可选，用于知识图谱检索）
NEO4J_URL=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database

# FastAPI 服务端口
AGENT_PORT=8001
AGENT_API_URL=http://127.0.0.1:8001

# MySQL（构建知识库脚本使用）
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=legal_db

# Meilisearch（构建知识库脚本使用，可选）
MEILI_URL=http://127.0.0.1:7700
MEILI_KEY=your_meilisearch_master_key

# 如需代理访问外部 API，取消注释并填写
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
